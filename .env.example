# AeroWeaver example configuration
# Copy to .env. Never commit real API keys or infrastructure credentials.

# Server
AEROWEAVER_PORT=5001
FLASK_SECRET_KEY=replace-with-a-random-secret

# Simulator: mock | airsim | airsim_physics | px4 | gazebo_direct
SIM_ADAPTER=mock
AEROWEAVER_UAV_COUNT=3
AEROWEAVER_AIRSIM_POOL_SIZE=10
AEROWEAVER_ALLOW_MOCK_FALLBACK=0

# AirSim RPC
AIRSIM_HOST=127.0.0.1
AIRSIM_PORT=41451
AIRSIM_VEHICLE_NAME=Drone_1
AIRSIM_BOTTOM_DISTANCE_SENSOR=BottomDistance
AIRSIM_HOVER_CLEARANCE=4.0
AIRSIM_MIN_FLIGHT_CLEARANCE=5.0
AIRSIM_CRUISE_CLEARANCE=8.0

# Optional AirSim browser camera relay
AIRSIM_CAMERA_RELAY_ENABLED=false
AIRSIM_CAMERA_RELAY_URL=http://127.0.0.1:8765
AIRSIM_CAMERA_FRONT=front
AIRSIM_CAMERA_RIGHT=right
AIRSIM_CAMERA_LEFT=left
AIRSIM_CAMERA_DOWN=down
AIRSIM_CAMERA_REAR=rear
AIRSIM_SCENE_CAMERA=overview

# LLM mode: OpenAI-compatible endpoint
ACTIVE_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o

# Optional vision-language model
VLM_BASE_URL=https://api.openai.com/v1
VLM_API_KEY=
VLM_MODEL=gpt-4o

# Optional local Ollama provider
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# Optional additional providers
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=

# Working directory for file-based cognitive skills
AEROWEAVER_WORKDIR=.
